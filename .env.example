POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
# O valor de DATABASE_URL é montado no docker-compose a partir das variáveis
# acima e injetado tanto no serviço `api` (Django) quanto no `inventory`
# (FastAPI/SQLAlchemy via Alembic, Aula 6).
# Aula 7 (segredos — NUNCA versionar valores reais; este arquivo é o exemplo):
# Gere valores fortes com:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
DJANGO_SECRET_KEY=gerar-chave-aleatoria-de-50-chars
DJANGO_DEBUG=True
# Chave de assinatura do JWT (SimpleJWT). Se ausente, settings.py usa o
# DJANGO_SECRET_KEY como fallback. Separar as duas chaves limita o impacto
# de um vazamento (menor privilégio por segredo).
JWT_SIGNING_KEY=gerar-outra-chave-aleatoria-de-50-chars
# Aula 8 (cache-aside com Redis) — todas opcionais: sem elas, o
# docker-compose usa os padrões entre parênteses.
#   REDIS_URL         -> conexão do cache (padrão: redis://redis:6379/1, db 1
#                        exclusivo do cache; o db 0 fica livre para a Aula 9+).
#   CACHE_ENABLED     -> false desliga o cache por completo e devolve a API
#                        ao comportamento "antes da Aula 8". É o switch usado
#                        para medir o baseline de desempenho.
#   CACHE_TTL_LIST    -> TTL (s) das listagens (padrão: 60).
#   CACHE_TTL_DETAIL  -> TTL (s) do detalhe/consulta pesada (padrão: 300).
#   CACHE_LOG_LEVEL   -> nível do logger JSON "core.cache" (padrão: INFO).
#   DRF_ANON_RATE     -> cota de requisições anônimas (padrão Aula 7: 20/min).
#   DRF_USER_RATE     -> cota de requisições autenticadas (padrão: 100/min).
#                        As duas últimas existem para que a medição de RPS da
#                        Aula 8 não seja cortada por 429 (veja scripts/).
REDIS_URL=redis://redis:6379/1
CACHE_ENABLED=true
CACHE_TTL_LIST=60
CACHE_TTL_DETAIL=300
CACHE_LOG_LEVEL=INFO
DRF_ANON_RATE=20/min
DRF_USER_RATE=100/min
