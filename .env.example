POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
# O valor de DATABASE_URL é montado no docker-compose a partir das variáveis
# acima e injetado tanto no serviço `api` (Django) quanto no `inventory`
# (FastAPI/SQLAlchemy via Alembic, Aula 6).
# Aula 7 (segredos — NUNCA versionar valores reais; este arquivo é o exemplo):
# Gere valores fortes com:
#   python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
DJANGO_SECRET_KEY=gerar-chave-aleatoria-de-50-chars
DJANGO_DEBUG=True
# Chave de assinatura do JWT (SimpleJWT). Se ausente, settings.py usa o
# DJANGO_SECRET_KEY como fallback. Separar as duas chaves limita o impacto
# de um vazamento (menor privilégio por segredo).
JWT_SIGNING_KEY=gerar-outra-chave-aleatoria-de-50-chars
# Aula 8 (cache-aside com Redis) — todas opcionais: sem elas, o
# docker-compose usa os padrões entre parênteses.
#   REDIS_URL         -> conexão do cache (padrão: redis://redis:6379/1, db 1
#                        exclusivo do cache; o db 0 fica livre para a Aula 9+).
#   REDIS_URL_DEDUPE  -> conexão da janela de deduplicação da Aula 9
#                        (padrão: redis://redis:6379/0, o db 0 reservado).
#   CACHE_ENABLED     -> false desliga o cache por completo e devolve a API
#                        ao comportamento "antes da Aula 8". É o switch usado
#                        para medir o baseline de desempenho.
#   CACHE_TTL_LIST    -> TTL (s) das listagens (padrão: 60).
#   CACHE_TTL_DETAIL  -> TTL (s) do detalhe/consulta pesada (padrão: 300).
#   CACHE_LOG_LEVEL   -> nível do logger JSON "core.cache" (padrão: INFO).
#   DRF_ANON_RATE     -> cota de requisições anônimas (padrão Aula 7: 20/min).
#   DRF_USER_RATE     -> cota de requisições autenticadas (padrão: 100/min).
#                        As duas últimas existem para que a medição de RPS da
#                        Aula 8 não seja cortada por 429 (veja scripts/).
REDIS_URL=redis://redis:6379/1
CACHE_ENABLED=true
CACHE_TTL_LIST=60
CACHE_TTL_DETAIL=300
CACHE_LOG_LEVEL=INFO
DRF_ANON_RATE=20/min
DRF_USER_RATE=100/min
# Aula 9 (mensageria assíncrona com RabbitMQ) — OPTIONAL desde a Aula 10.
# Criar o broker exige um usuário de aplicação: o usuário `guest` do RabbitMQ
# só aceita conexões de localhost, então o compose provisiona o usuário abaixo
# no 1º start. Para subir com RabbitMQ (e não com o Kafka padrão), veja
# "Rodando com RabbitMQ" no README: `docker compose --profile rabbitmq up -d`
# mais `MENSAGERIA_BROKER=rabbitmq` no `.env`.
#   RABBITMQ_USER / RABBITMQ_PASSWORD -> credenciais do broker (padrão dev:
#                                        synapse/synapse — troque em qualquer
#                                        ambiente que não seja local).
#   RABBITMQ_URL     -> opcional; o docker-compose monta a URL AMQP a partir
#                       das duas variáveis acima. Só é preciso definir à mão
#                       para rodar o Django no venv local apontando para
#                       localhost:5672.
#   REDIS_URL_DEDUPE -> janela de idempotência (db 0, exclusivo da Aula 9).
#   DEDUPE_TTL_SEGUNDOS -> validade da chave de deduplicação (padrão: 86400
#                       = 24 h; precisa ser maior que a soma da escada de
#                       reentrega, para a chave não expirar em trânsito).
#   PEDIDO_MAX_REENTREGAS -> reentregas após a tentativa inicial (padrão: 3).
#   PEDIDO_BACKOFF_SEGUNDOS -> atraso de cada reentrega, em segundos; o
#                       tamanho da lista define quantas filas de retry
#                       existem (padrão: 5,15,45).
#   PEDIDO_PERMITIR_SIMULACAO_FALHA -> true habilita o header
#                       `X-Simular-Falha`, que marca um pedido para o worker
#                       falhar de propósito (validação da DLQ). Mantenha
#                       false fora de desenvolvimento.
#   MESSAGING_LOG_LEVEL -> nível do logger JSON "core.messaging" (INFO).
RABBITMQ_USER=synapse
RABBITMQ_PASSWORD=synapse
REDIS_URL_DEDUPE=redis://redis:6379/0
DEDUPE_TTL_SEGUNDOS=86400
PEDIDO_MAX_REENTREGAS=3
PEDIDO_BACKOFF_SEGUNDOS=5,15,45
PEDIDO_PERMITIR_SIMULACAO_FALHA=true
MESSAGING_LOG_LEVEL=INFO

# Aula 10 (Apache Kafka — broker PADRÃO).
#   MENSAGERIA_BROKER -> 'kafka' (padrão) ou 'rabbitmq'. É a única variável que
#                       troca o transporte no projeto inteiro (ver
#                       api/core/messaging/broker.py); o `GET /health` e o log
#                       `WorkerIniciado` mostram qual está ativo.
MENSAGERIA_BROKER=kafka

# Kafka: só as settings que mudam entre ambientes. Todas têm padrão em
# api/config/settings.py, então uma instalação mínima é só `MENSAGERIA_BROKER`.
#   KAFKA_BOOTSTRAP_SERVERS -> ⚠️ NÃO edite para o compose. Dentro do compose o
#                       docker-compose fixa o listener interno (kafka:29092)
#                       justamente para que o `.env` não aponte a API para o
#                       localhost dela mesma. Esta variável vale para o Django
#                       rodando no venv LOCAL, onde o broker está publicado em
#                       localhost:9092.
#   KAFKA_PARTICOES -> eixo de paralelismo do consumo. NÃO pode mudar depois
#                       que o tópico existe (o broker recusa reduzir, e o
#                       remapeamento key→partição perde a ordem por pedido).
#                       A medição 1 vs 3 consumidores usa 1 vs 3 partições.
#   KAFKA_RETENCAO_MS / KAFKA_RETENCAO_DLQ_MS -> retenção do tópico principal
#                       (7 dias) e da DLQ (30 dias). Em Kafka a retenção APAGA
#                       a mensagem, então a DLQ precisa ser longa: é a única
#                       cópia do evento que deu problema.
#   KAFKA_FOLGA_RETENCAO_RETRY_MS -> folga somada ao `2 × degrau` na retenção
#                       de cada tópico de retry (10 min), para o replayer poder
#                       estar reiniciado sem perder mensagem.
#   KAFKA_AUTO_OFFSET_RESET -> 'earliest' (padrão) para o teste de replay reler
#                       o histórico; 'latest' é o padrão seguro em produção
#                       (não reprocessar o passado).
#   KAFKA_LINGER_MS -> janela de agrupamento de publicações (padrão 5 ms):
#                       é um dos eixos medidos na Aula 10.
#   KAFKA_COMPRESSAO -> 'none' (padrão) para não confundir a comparação entre
#                       brokers; 'gzip'/'snappy' medem outro eixo.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PARTICOES=3
KAFKA_REPLICAS=1
KAFKA_RETENCAO_MS=604800000
KAFKA_RETENCAO_DLQ_MS=2592000000
KAFKA_FOLGA_RETENCAO_RETRY_MS=600000
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_LINGER_MS=5
KAFKA_COMPRESSAO=none

# Kafka - Aula 11: segundo fluxo de eventos (pagamento -> notificacao).
#
# O fluxo de pagamento é um TÓPICO À PARTE, não mais um tipo de evento dentro
# de `pedidos.criados`. Group, offset e DLQ próprios porque cada fluxo é
# consumido por um worker diferente (worker-kafka / worker-pagamentos): se
# dividissem o tópico, as partições seriam disputadas e não daria para escalar um
# sem o outro. A política de reentrega (PEDIDO_MAX_REENTREGAS e
# PEDIDO_BACKOFF_SEGUNDOS) é COMPARTILHADA — os dois fluxos precisam do mesmo
# comportamento, e o nome dos tópicos de retry nasce do tópico base
# (`pagamentos.registrados.retry.1`), sem constante nova.
#
#   KAFKA_TOPICO_PAGAMENTOS* -> tópico principal e DLQ do segundo fluxo.
#   KAFKA_PARTICOES_PAGAMENTOS -> eixo de paralelismo próprio (mesma regra de
#                       KAFKA_PARTICOES: não pode reduzir depois de criado).
#   KAFKA_GRUPO_PAGAMENTOS* -> `group.id` do worker e do replayer do fluxo.
#   PAGAMENTO_PERMITIR_SIMULACAO_FALHA -> true habilita o header
#                       `X-Simular-Falha` no POST de pagamento, para provar a
#                       escada de reentrega e a DLQ DESTE fluxo. Mesmo header e
#                       mesmo efeito de PEDIDO_PERMITIR_SIMULACAO_FALHA: são duas
#                       DLQs (tópicos) diferentes para a mesma sabotagem, e o
#                       que muda é o fluxo onde a mensagem trava.
#
#                       Como a de pedidos, e consultada **pela API** (é ela que
#                       decide se aceita o header). O worker não lê esta flag:
#                       ele honra `simular_falha` gravado no pagamento. Defini-la
#                       no worker não muda nada.
KAFKA_TOPICO_PAGAMENTOS=pagamentos.registrados
KAFKA_TOPICO_PAGAMENTOS_DLQ=pagamentos.registrados.dlq
KAFKA_PARTICOES_PAGAMENTOS=3
KAFKA_GRUPO_PAGAMENTOS=synapseshop-pagamentos
KAFKA_GRUPO_PAGAMENTOS_REPLAY=synapseshop-pagamentos-replay
PAGAMENTO_PERMITIR_SIMULACAO_FALHA=true

# Aula 14 (camada de IA — llm_service) — todas OPCIONAIS: sem elas, o
# docker-compose usa os padrões entre parênteses.
#
# O provedor de HOJE é um mock em memória (LLM_PROVIDER=mock): nada de rede
# nem de credenciais. O sistema já está pronto para receber o provedor real no
# futuro — entra um adaptador que cumpre `core.llm.portas.ProvedorLlm` e o
# seleciona por esta mesma variável, sem mudar a resiliência.
#   LLM_PROVIDER        -> provedor selecionado ('mock'). Qualquer outro valor
#                          faz a API recusar o boot com LlmConfiguracaoInvalida
#                          (fail-fast, em vez de silenciosamente cair no mock).
#   LLM_MODEL           -> modelo endereçado (padrão: mock). Hoje é
#                          informacional (log/telemetria); no futuro vai no
#                          corpo do completamento.
#   LLM_TIMEOUT_SEGUNDOS -> deadline da guarda genérica (padrão: 5.0; a spec
#                          pede <= 5 s).
#   LLM_MAX_TENTATIVAS  -> execuções da chamada por pedido (padrão: 3).
#   LLM_BACKOFF_BASE_SEGUNDOS / LLM_BACKOFF_FATOR -> escada do backoff
#                          exponencial (padrão: 1.0 e 2.0).
#   LLM_BACKOFF_JITTER  -> true ativa o *full jitter* no atraso (padrão: true),
#                          para não sincronizar os clientes após um rate limit.
#   LLM_CB_LIMITE_FALHAS -> falhas consecutivas para ABRIR o circuito (5).
#   LLM_CB_COOLDOWN_SEGUNDOS -> tempo em 'open' antes de sondar (padrão: 30.0).
#   LLM_CB_MAX_TENTATIVAS_HALF_OPEN -> chamadas de sonda em 'half-open' (2).
#   LLM_LOG_LEVEL       -> nível do logger JSON "core.llm" (padrão: INFO).
#   LLM_REDACAO_ATIVA   -> false desliga a redação de PII/segredos antes de
#                          enviar ao provedor e de logar. Mantenha true fora de
#                          desenvolvimento/benchmark.
#   LLM_CUSTO_INPUT_POR_1M_TOKENS / LLM_CUSTO_OUTPUT_POR_1M_TOKENS -> preço em
#                          USD por 1 milhão de tokens para a ESTIMATIVA de custo
#                          por chamada (defaults de exemplo: o mock não cobra).
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_TIMEOUT_SEGUNDOS=5.0
LLM_MAX_TENTATIVAS=3
LLM_BACKOFF_BASE_SEGUNDOS=1.0
LLM_BACKOFF_FATOR=2.0
LLM_BACKOFF_JITTER=true
LLM_CB_LIMITE_FALHAS=5
LLM_CB_COOLDOWN_SEGUNDOS=30.0
LLM_CB_MAX_TENTATIVAS_HALF_OPEN=2
LLM_LOG_LEVEL=INFO
LLM_REDACAO_ATIVA=true
LLM_CUSTO_INPUT_POR_1M_TOKENS=5.00
LLM_CUSTO_OUTPUT_POR_1M_TOKENS=15.00
# Placeholders do provedor REAL (ainda NÃO lidos pelo código — entram junto com
# o adaptador de HTTP numa iteração futura). Mantidos comentados aqui para
# deixar explícito o que faltará quando LLM_PROVIDER deixar de ser 'mock':
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
