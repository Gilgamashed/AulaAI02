            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"APL-IP15-256\",\n  \"name\": \"iPhone 15 256GB\",\n  \"quantity\": -1,\n  \"reserved\": 0,\n  \"reorder_level\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory"]
            },
            "description": "POST com quantity < 0. Esperado: 400 Bad Request."
