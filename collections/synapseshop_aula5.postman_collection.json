    {
      "name": "Inventory",
      "item": [
        {
          "name": "Listar itens de estoque",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/inventory",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory"]
            },
            "description": "GET list. Esperado: 200 com a lista de itens no envelope."
          },
          "response": []
        },
        {
          "name": "Criar item de estoque",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"APL-IP15-128\",\n  \"name\": \"iPhone 15 128GB\",\n  \"quantity\": 10,\n  \"reserved\": 0,\n  \"reorder_level\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory"]
            },
            "description": "POST. Esperado: 201 Created. SKU no formato '^[A-Z]{2,4}-[A-Z0-9-]+$'."
          },
          "response": []
        },
        {
          "name": "Criar item duplicado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"APL-IP15-128\",\n  \"name\": \"iPhone 15 128GB\",\n  \"quantity\": 10,\n  \"reserved\": 0,\n  \"reorder_level\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory"]
            },
            "description": "POST com SKU já registrado. Esperado: 409 Conflict (envelope error)."
          },
          "response": []
        },
        {
          "name": "Criar item inválido (SKU fora do padrão)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"sku-invalido\",\n  \"name\": \"iPhone 15 128GB\",\n  \"quantity\": 10,\n  \"reserved\": 0,\n  \"reorder_level\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventory",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventory"]
            },
            "description": "POST com SKU fora do padrão '^[A-Z]{2,4}-[A-Z0-9-]+$'. Esperado: 400 Bad Request (handler customizado)."
          },
          "response": []
        },
        {
