    {
      "name": "Throttling",
      "item": [
        {
          "name": "Login burst 1/6",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"errada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", ""]
            },
            "description": "Burst de login (scope 'login' = 5/min). Execute as 6 tentativas em sequência rápida; a partir da 5ª/6ª: 429 Too Many Requests."
          },
