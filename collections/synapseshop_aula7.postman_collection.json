            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"errada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", ""]
            },
            "description": "Tentativa 3/6 do burst (ver burst 1/6)."
          },
          "response": []
        },
        {
          "name": "Login burst 4/6",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"errada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", ""]
            },
            "description": "Tentativa 4/6 do burst (ver burst 1/6)."
          },
          "response": []
        },
        {
          "name": "Login burst 5/6",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"errada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
