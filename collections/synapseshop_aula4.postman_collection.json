        {
          "name": "Categoria inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/999999/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "999999", ""]
            },
            "description": "GET detail inexistente. Esperado: 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Atualizar categoria (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smartphones e Tablets\",\n  \"description\": \"Dispositivos móveis, tablets e acessórios.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "1", ""]
            },
            "description": "PUT completo. Esperado: 200."
          },
          "response": []
        },
        {
          "name": "Atualizar categoria (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Somente a descrição é alterada.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "1", ""]
            },
            "description": "PATCH parcial. Esperado: 200."
          },
          "response": []
        },
        {
          "name": "Excluir categoria",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "1", ""]
            },
            "description": "DELETE. Esperado: 204 No Content. (CASCADE remove os itens da categoria.)"
          },
          "response": []
        }
      ]
    },
