    {
      "name": "Categories",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", ""]
            },
            "description": "GET list. Esperado: 200."
          },
          "response": []
        },
        {
          "name": "Criar categoria",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smartphones\",\n  \"description\": \"Dispositivos móveis e acessórios.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", ""]
            },
            "description": "POST. Esperado: 201 Created. O slug é gerado automaticamente."
          },
          "response": []
        },
        {
          "name": "Obter categoria por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories", "1", ""]
