            "url": {
              "raw": "{{base_url}}/api/v1/pedidos/{{pedido_recusado_id}}/pagamento/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pedidos", "{{pedido_recusado_id}}", "pagamento", ""]
